# Who the server runs as. Copy this to .env and put your own ids in, or just:
#
#     echo PHANTOM_UID=$(id -u) > .env
#     echo PHANTOM_GID=$(id -g) >> .env
#
# Only needed when your uid is not 1000, which is the default in
# docker-compose.yml and the first ordinary user on most Linux systems.
#
# Check yours with: id -u ; id -g
PHANTOM_UID=1000
PHANTOM_GID=1000
